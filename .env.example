# 本地访问码 — 自己设置的长随机字符串，用于保护本地生成接口
# 在前端生成页输入此码后才会调用真实 API
ALITTLEMOVIE_ACCESS_CODE=your_random_access_code_here

# ============ 视频生成服务商（VIDEO_PROVIDER） ============
# 可选：minimax（默认） | libtv | mock
VIDEO_PROVIDER=minimax

# --- MiniMax（VIDEO_PROVIDER=minimax 时必填）---
# 在 MiniMax 开放平台 (https://platform.minimax.io/) 获取 API Key
MINIMAX_API_KEY=your_minimax_api_key_here

# 可选：API 域名。默认 https://api.minimax.io；中国大陆账号可设为 https://api.minimax.cn
# MINIMAX_API_BASE=https://api.minimax.cn

# --- LibTV 角色模型（VIDEO_PROVIDER=libtv 时必填）---
# 在 liblib.tv「用户中心 > API」获取 access key
LIBTV_ACCESS_KEY=your_libtv_access_key_here

# 可选：LibTV 视频模型。默认 seedance-2.0-vip，也可用 kling-3.0 / wan-2.6 等
# LIBTV_VIDEO_MODEL=seedance-2.0-vip
# 可选：LibTV OpenAPI 域名。默认 https://im.liblib.tv
# LIBTV_API_BASE=https://im.liblib.tv

# ============ 定妆图生成服务商（IMAGE_PROVIDER） ============
# 可选：minimax（默认） | libtv
IMAGE_PROVIDER=minimax

# 可选：LibTV 定妆图模型（IMAGE_PROVIDER=libtv 时生效）。默认 seedream-5.0（写实）
# LIBTV_IMAGE_MODEL=seedream-5.0

# 可选：Supabase 数据库持久化
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key